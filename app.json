{
  "expo": {
    "name": "expo-scaffolded-app",
    "slug": "expo-scaffolded-app",
    "scheme": "expo-scaffolded-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sh.zelda.exposcaffoldedapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "sh.zelda.exposcaffoldedapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-ios-scene-lifecycle-plugin",
      "expo-status-bar",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Google Sans Flex",
                "fontDefinitions": [
                  {
                    "path": "./assets/google-sans-flex/GoogleSansFlex-400.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/google-sans-flex/GoogleSansFlex-500.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/google-sans-flex/GoogleSansFlex-600.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/google-sans-flex/GoogleSansFlex-700.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
